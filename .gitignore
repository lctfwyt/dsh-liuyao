# ── 运行时/本地产物：绝不入库 ──────────────────────────────────────────────
# profile 配置备份与诊断转储：含本机绝对路径与用户名
backup/

# 临时产物：调研/审计报告、解包对照树、一次性脚本。含本机绝对路径，绝不入库。
.scratch/

# 测试用的临时目录（走系统临时目录失败时才会用到）
test/.tmp/

# 依赖与工具产物
node_modules/
*.log
npm-debug.log*
pnpm-debug.log*

# 沙箱/CI 下把 npm 缓存定向到工作区时产生（默认缓存目录在工作区外）
.npm-cache/
# npm pack 产出的 tarball
*.tgz

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
